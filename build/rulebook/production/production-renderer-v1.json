{
  "schema": "cybermancy-production-renderer-contract-v1",
  "version": "1.0",
  "contractStatus": "ACCEPTED",
  "implementationStatus": "PHASE_D_PUBLICATION_SHELL",
  "purpose": "Define the authoritative release-build boundary around the accepted Step 6 whole-book renderer without changing frozen chapter publication grammars.",
  "frozenBindingHashAlgorithm": "sha256-utf8-normalized-lf-v1",
  "authorities": {
    "publicationManifest": {
      "directory": "build/rulebook/manifests",
      "pattern": "cybermancy-rulebook-publication-manifest-v*.json",
      "tracked": true,
      "selection": "single highest compatible accepted version"
    },
    "assemblyManifest": {
      "directory": "build/rulebook/manifests",
      "pattern": "cybermancy-rulebook-assembly-manifest-v*.json",
      "tracked": true,
      "selection": "version compatible with the selected publication manifest"
    },
    "normalizationConfig": {
      "directory": "build/rulebook/manifests",
      "pattern": "cybermancy-rulebook-normalization-config-v*.json",
      "tracked": true,
      "selection": "version compatible with the selected assembly manifest"
    },
    "step6IntegrationContract": {
      "path": "build/rulebook/layout/integration/step6-integration-v1.json",
      "sha256": "b46ff8b46ed742046d52d1d7fd49d5d090e145216e9cc45245b4564f8cc339be",
      "status": "accepted"
    },
    "generatedPublicationSource": {
      "path": "build/rulebook/source",
      "tracked": false,
      "producer": "Step 4",
      "mutationAllowed": false
    }
  },
  "upstreamReadiness": {
    "mode": "validate-existing-step4-output",
    "automaticStep4Rebuild": false,
    "failClosed": true,
    "requiredArtifacts": [
      "build/rulebook/source/assembled/player-guide.md",
      "build/rulebook/source/assembled/complete-rulebook.md",
      "build/rulebook/source/metadata/validation.json",
      "build/rulebook/source/metadata/source-hashes.json",
      "build/rulebook/source/metadata/structured-entities.json",
      "build/rulebook/source/metadata/adversary-feature-publication-selection.json",
      "build/rulebook/source/assets"
    ],
    "freshnessRules": [
      "The selected accepted manifests and normalization config must be present, mutually compatible, and tracked by Git.",
      "Step 4 validation.json must have status PASS.",
      "The Step 4 source commit and manifest provenance must match the selected freeze artifacts.",
      "Current canonical authored and structured-source digests must match the selected publication manifest.",
      "The normalized source-hashes inventory must match the selected manifest authority and current canonical inputs.",
      "All configured mutable structured source-family corpus counts and semantic IDs must reconcile to the selected publication manifest through Step 4 before rendering.",
      "ICE and Adversary Feature publication projections must reconcile dynamically to their authoritative Step 4 source families before rendering.",
      "The Adversary Feature publication-selection status must be APPLIED and its representative/excluded semantic IDs must partition the authoritative source family."
    ]
  },
  "profiles": {
    "complete-rulebook": {
      "audiences": ["shared", "player", "gm"],
      "parts": ["part-i", "part-ii", "part-iii", "part-iv", "part-v", "part-vi"],
      "releaseFilename": "Cybermancy_Core_Rulebook.pdf",
      "gmDividerCount": 1
    },
    "player-guide": {
      "audiences": ["shared", "player"],
      "parts": ["part-i", "part-ii", "part-iii", "part-iv"],
      "releaseFilename": "Cybermancy_Player_Guide.pdf",
      "gmDividerCount": 0,
      "forbiddenAudiences": ["gm"]
    }
  },
