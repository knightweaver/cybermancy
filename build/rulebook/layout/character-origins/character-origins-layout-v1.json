  "inherits": {
    "layoutContract": "build/rulebook/layout/prose/prose-layout-v1.json",
    "version": "1.0",
    "rule": "Long-Form Prose v1.0 remains authoritative for page geometry, typography, chapter banners, running furniture, body columns, ordinary prose, asset staging, and Pandoc/LuaLaTeX production behavior. This contract defines only the Chapter 10-11 entry delta."
