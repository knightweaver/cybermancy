      "imageColumnFraction": 0.36,
      "gapColumnFraction": 0.04,
      "textColumnFraction": 0.6,
      "imageMaxHeightInches": 1.48,
      "contains": [
        "entry artwork",
        "entry heading",
        "first flavor paragraph"
      ],
      "titleSizePt": 13.2,
      "titleLeadingPt": 14.8
    },
    "remainingFlavor": "ordinary inherited prose flow",
    "featureGroup": {
      "labelStyle": "compact uppercase teal label",
      "featureNameSizePt": 11.6,
      "featureNameLeadingPt": 13.2,
      "rulesText": "inherited prose body size and leading",
      "breakability": "feature descriptions remain page/column breakable",
      "ancestryMarker": "Features",
      "communityMarker": "Community Feature — <name>"
    },
    "separator": "subtle inherited teal section rule",
    "entrySpecificExceptions": false
  },
