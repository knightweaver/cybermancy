{
  "schema": "cybermancy-rulebook-rules-layout-v1",
  "version": "1.0-prototype",
  "status": "PROTOTYPE",
  "scope": ["part-ii-rules"],
  "inherits": {
    "contract": "build/rulebook/layout/prose/prose-layout-v1.json",
    "version": "1.0",
    "policy": "inherit page geometry, typography, chapter grammar, two-column flow, source-order pagination, staged assets, and LuaLaTeX toolchain unless explicitly overridden here"
  },
  "sourceContract": {
    "primary": "build/rulebook/source/assembled/player-guide.md",
    "crossProfile": "build/rulebook/source/assembled/complete-rulebook.md",
    "assetRoot": "build/rulebook/source/assets",
    "canonicalContentMutable": false,
    "layoutMayRewriteCanonicalProse": false
  },
  "requiredChapters": [4, 5, 6, 7, 8, 9],
  "designProofChapters": [4, 6, 8, 9],
  "primitives": {
    "ordinaryRulesProse": "inherited-long-form-prose",
    "chapterRootHeading": {
      "sourceStructure": "first normalized level-3 heading in each chapter fragment",
      "treatment": "suppressed because the publication chapter banner owns the chapter title",
      "semanticInference": false
    },
    "procedure": {
      "sourceStructure": "ordered-list",
      "treatment": "compact-accented-number-sequence",
      "semanticInference": false
    },
    "referenceTable": {
      "sourceStructure": "pandoc-table",
      "treatment": "full-width-rules-reference-table",
      "equipmentCatalogReuse": false,
      "repeatedHeaders": true,
      "compactNumericSupport": true
    },
    "blockquote": {
      "sourceStructure": "blockquote",
      "treatment": "neutral-rules-blockquote",
      "italicByDefault": false,
      "semanticSubtypeInference": false
    },
    "standardImage": {
      "sourceStructure": "standard source-order image",
      "treatment": "compact-centered-rules-image",
      "maxHeight": "0.20 textheight",
      "maxWidth": "columnwidth",
      "preserveAspectRatio": true,
      "semanticInference": false
    },
    "workedExample": {
      "dedicatedPrimitive": false,
      "policy": "compose from ordinary prose, lists, tables, and blockquotes until explicit semantics justify a separate primitive"
    },
    "stateTrack": {
      "status": "deferred-semantic-gate",
      "policy": "preserve source text; do not infer track states from arrow-delimited prose"
    },
    "chapterLeadArt": {
      "status": "deferred-semantic-gate",
      "policy": "preserve source order; use the compact standard-image treatment unless explicit chapter-lead semantics are added; do not reconstruct MkDocs grid semantics"
    }
  },
  "semanticBacklog": [
    "rulesCallout.kind",
    "imageRole=chapter-lead",
    "stateTrack.label+states"
  ],
  "validation": {
    "requirePrimaryProfile": true,
    "crossProfilePartIIByteEquivalenceWhenAvailable": true,
    "requireAllPartIIChapters": true,
    "rejectImageHeadingAdjacencyDefects": true,
    "rejectRawHtmlLeakage": true,
    "visualInspectionRequired": true
  }
}
