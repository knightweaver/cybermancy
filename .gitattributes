# Keep Git attributes deterministic.
/.gitattributes text eol=lf

# Byte-bound rulebook inventory artifacts.
/build/rulebook/inventory/*.json text eol=lf
/build/rulebook/inventory/*.csv  text eol=lf
/build/rulebook/inventory/*.md   text eol=lf

# Versioned rulebook freeze artifacts.
/build/rulebook/manifests/*.json text eol=lf
/build/rulebook/manifests/*.md   text eol=lf