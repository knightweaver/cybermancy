{
  "name": "cybermancy",
  "version": "1.0.0",
  "description": "Just getting started",
  "main": "index.js",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "cleanup": "rimraf stage packs",
    "descriptor2loadable": "node scripts/descriptor2loadableJSON.mjs",
    "validate:domains": "node tools/validate-domain-registration.mjs",
    "convert-jpg-to-webp": " py .\\convert_and_resize_png_to_webp.py --width 400 --height 400 --dpi 96 --quality 8 --lossless --recursive ..\\assets\\icons\\",
    "convert descriptors to loadable": "py .\\pyCybermancy\\convert-descriptors-to-loadable.py .\\src-descriptors\\weapons.csv -o .\\src-loadable\\ -c .\\src-descriptors\\actions-by-category.json",
    "browse images": "node scripts/image-browser.mjs",
    "atlas:check": "node scripts/maps/sync-atlas-audience.mjs --check && node scripts/maps/validate-atlas-art.mjs",
    "atlas:sync": "node scripts/maps/sync-atlas-audience.mjs --write",
    "zip command": "tar -a -c -f cybermancy.zip --exclude=cybermancy/.git --exclude=cybermancy/node_modules --exclude=cybermancy/.idea --exclude=cybermancy/pyCybermancy --exclude=cybermancy/src-descriptors cybermancy",
    "batch image generation": "py .\\batch-image-generation-on-OpenAI.py --input .\\circuit_domain_cards_witty.csv --outdir .\\circuit-domain-img --effect-key domain",
    "validate:assets": "node tools/validate-runtime-assets.mjs",
    "docs:stage": "python tools/stage-mkdocs-assets.py",
    "docs:build:player": "mkdocs build --config-file mkdocs.player.staged.yml",
    "docs:build:gm": "mkdocs build --config-file mkdocs.gm.staged.yml",
    "docs:build": "npm run docs:stage && npm run docs:build:player && npm run docs:build:gm",
    "validate:release-manifest": "node tools/validate-release-manifest.mjs",
    "clean:packs": "rimraf packs",
    "compile:packs": "node tools/compile-packs.mjs",
    "extract:packs": "node tools/extract-packs.mjs",
    "validate:compiled-packs": "node tools/validate-compiled-packs.mjs",
    "build:runtime-package": "python tools/build-runtime-package.py --repo .",
    "validate:release": "npm run validate:release-manifest && npm run validate:domains && npm run validate:runtime-sheets && npm run validate:assets -- --strict-prefix",
    "build:release-candidate": "npm run validate:release && npm run clean:packs && npm run compile:packs && npm run validate:compiled-packs && npm run build:runtime-package",
    "atlas:validate-art": "node scripts/maps/validate-atlas-art.mjs",
    "validate:runtime-sheets": "node tools/validate-runtime-sheets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knightweaver/cybermancy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/knightweaver/cybermancy/issues"
  },
  "homepage": "https://github.com/knightweaver/cybermancy#readme",
  "dependencies": {
    "express": "^5.1.0"
  }
}
